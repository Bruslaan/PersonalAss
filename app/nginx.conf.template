daemon off;
worker_processes 1;
pid /tmp/cloud-browser/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 128; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/cloud-browser/body;
    proxy_temp_path /tmp/cloud-browser/proxy;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    map $http_origin $origin_host {
        default "";
        ~^https?://([^/]+)$ $1;
    }
    server {
        listen 0.0.0.0:@@PORT@@;
        auth_basic "Cloud Browser";
        auth_basic_user_file /tmp/cloud-browser/htpasswd;
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control "no-store" always;
        location = /healthz {
            auth_basic off;
            proxy_pass http://127.0.0.1:8091/healthz;
        }
        location = /websockify {
            # Reject cross-site WebSockets even with cached Basic credentials.
            if ($origin_host != $http_host) { return 403; }
            proxy_pass http://127.0.0.1:6080;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Origin $http_origin;
            proxy_set_header Host $http_host;
            proxy_set_header Authorization "";
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }
        location = / {
            # try_files runs after authentication; no public redirect bypass.
            root /app;
            try_files /index.html =404;
        }
        location / {
            root /usr/share/novnc;
            try_files $uri =404;
        }
    }
}
